// BraveVest Marketplace — Phase 1 & 2 only
// Proposal No. BV-QT-2026-001

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  INVESTOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum IdType {
  NIN
  BVN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum ProjectCategory {
  REAL_ESTATE
  AGRICULTURE
  ENERGY
  SME
  INFRASTRUCTURE
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  FUNDED
  CLOSED
  CANCELLED
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  ACTIVE
  MATURED
  WITHDRAWN
  CANCELLED
  DEFAULTED
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  RETURN
  WITHDRAWAL
  REFUND
  FEE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  MANUAL
}

enum DocumentType {
  ID_CARD
  PASSPORT_PHOTO
  PROOF_OF_ADDRESS
  BANK_STATEMENT
  UTILITY_BILL
  SIGNATURE
  OTHER
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  INVESTMENT_CREATED
  INVESTMENT_CONFIRMED
  PROJECT_CREATED
  PROJECT_UPDATED
  PAYMENT_INITIALIZED
  PAYMENT_VERIFIED
  ADMIN_ACTION
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole   @default(INVESTOR)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified DateTime?
  image         String?

  kyc           KycProfile?
  investments   Investment[]
  transactions  Transaction[]
  documents     Document[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model KycProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status KycStatus @default(NOT_STARTED)

  dateOfBirth DateTime?
  gender      String?
  nationality String?
  occupation  String?

  idType       IdType?
  idNumber     String?
  idIssuedDate DateTime?
  idExpiryDate DateTime?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("NG")

  bankName      String?
  bankCode      String?
  accountNumber String?
  accountName   String?

  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  providerRef   String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("kyc_profiles")
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  summary     String
  description String          @db.Text
  category    ProjectCategory
  status      ProjectStatus   @default(DRAFT)

  coverImage String?
  gallery    String[]        @default([])
  documents  String[]        @default([])

  targetAmount      Decimal @db.Decimal(18, 2)
  minInvestment     Decimal @db.Decimal(18, 2)
  raisedAmount      Decimal @db.Decimal(18, 2) @default(0)
  expectedReturnPct Decimal @db.Decimal(5, 2)
  tenorMonths       Int
  payoutFrequency   String?

  startDate DateTime?
  endDate   DateTime?
  closesAt  DateTime?

  location    String?
  riskLevel   String?
  isFeatured  Boolean @default(false)
  createdById String

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@map("projects")
}

model Investment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  projectId String
  project   Project          @relation(fields: [projectId], references: [id])
  status    InvestmentStatus @default(PENDING)

  amount         Decimal @db.Decimal(18, 2)
  units          Int     @default(1)
  expectedReturn Decimal @db.Decimal(18, 2)
  actualReturn   Decimal @db.Decimal(18, 2) @default(0)

  investedAt  DateTime?
  maturesAt   DateTime?
  withdrawnAt DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("investments")
}

model Transaction {
  id           String      @id @default(cuid())
  reference    String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  investmentId String?
  investment   Investment? @relation(fields: [investmentId], references: [id])

  type     TransactionType
  status   TransactionStatus @default(PENDING)
  provider PaymentProvider   @default(PAYSTACK)

  amount    Decimal @db.Decimal(18, 2)
  fee       Decimal @db.Decimal(18, 2) @default(0)
  netAmount Decimal @db.Decimal(18, 2)
  currency  String  @default("NGN")

  providerRef   String?
  providerMeta  Json?
  failureReason String?

  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([investmentId])
  @@index([status])
  @@index([reference])
  @@map("transactions")
}

model Document {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   DocumentType

  fileName String
  fileUrl  String
  fileSize Int?
  mimeType String?

  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@map("documents")
}

model AuditLog {
  id       String      @id @default(cuid())
  userId   String?
  user     User?       @relation(fields: [userId], references: [id])
  action   AuditAction
  entity   String?
  entityId String?
  meta     Json?
  ip       String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}


// ═══════════════════════════════════════════════════════════
// COMPETITOR-PARITY FEATURES (Phase 2.5)
// ═══════════════════════════════════════════════════════════

model SavingsGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  targetAmount Decimal @db.Decimal(18, 2)
  targetDate  DateTime?
  type        GroupType @default(CUSTOM)
  status      GroupStatus @default(ACTIVE)
  inviteCode  String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]

  @@index([createdById])
  @@index([status])
  @@map("savings_groups")
}

model GroupMember {
  id              String   @id @default(cuid())
  groupId         String
  group           SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  role            GroupRole @default(MEMBER)
  contributedAmount Decimal @db.Decimal(18, 2) @default(0)
  joinedAt        DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupContribution {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  amount    Decimal  @db.Decimal(18, 2)
  reference String   @unique
  status    TransactionStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([userId])
  @@map("group_contributions")
}

model InvestmentGoal {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           GoalType
  targetAmount   Decimal  @db.Decimal(18, 2)
  targetDate     DateTime
  currentAmount  Decimal  @db.Decimal(18, 2) @default(0)
  status         GoalStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("investment_goals")
}

model InvestorStreak {
  id              String   @id @default(cuid())
  userId          String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActivityAt  DateTime?
  recoveryUsed    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("investor_streaks")
}

model Insight {
  id          String   @id @default(cuid())
  title       String
  summary     String
  body        String   @db.Text
  category    String
  coverImage  String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([isPublished])
  @@map("insights")
}

model Username {
  id        String   @id @default(cuid())
  userId    String   @unique
  handle    String   @unique
  createdAt DateTime @default(now())

  @@map("usernames")
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  refereeId       String   @unique
  code            String
  status          ReferralStatus @default(PENDING)
  rewardAmount    Decimal? @db.Decimal(18, 2)
  qualifiedAt     DateTime?
  rewardedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

enum GroupType {
  COOPERATIVE
  FAMILY
  DIASPORA
  CHURCH
  WORKPLACE
  FRIENDS
  CUSTOM
}

enum GroupStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GoalType {
  RENT
  BUSINESS
  EDUCATION
  RETIREMENT
  PROPERTY
  EMERGENCY
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
}
