# ═══════════════════════════════════════════════
# BraveVest API — Environment Variables
# ═══════════════════════════════════════════════

NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bravevest"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payments
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxx"

# KYC
KYC_PROVIDER="smile_identity"
SMILE_IDENTITY_API_KEY="xxx"
SMILE_IDENTITY_PARTNER_ID="xxx"
VERIFYME_API_KEY="xxx"

# Credit Bureau (Phase 3 hook)
CRC_BUREAU_API_KEY="xxx"

# Notifications
SENDGRID_API_KEY="xxx"
EMAIL_FROM="BraveVest <no-reply@bravevest.com>"
TERMII_API_KEY="xxx"
TERMII_SENDER_ID="BraveVest"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
