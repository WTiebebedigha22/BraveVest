# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URLS=http://localhost:5173,https://brave-vest.vercel.app,https://wtiebebedigha22.github.io

# ── Database (Supabase session pooler, port 5432) ────────────
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-32-char-random-string
JWT_REFRESH_SECRET=replace-me-with-another-32-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Payments ─────────────────────────────────────────────────
PAYMENT_PROVIDER=paystack
PAYMENT_CALLBACK_URL=http://localhost:5173/#/payment/callback
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
