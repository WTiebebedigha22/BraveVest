# ═══════════════════════════════════════════════════════════
# BraveVest — root .env (docker compose overrides)
# Copy to .env and set real values before deploy.
# ═══════════════════════════════════════════════════════════

# Postgres
POSTGRES_USER=bravevest
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=bravevest

# Public API base URL (used by web container at build time)
# For same-domain Nginx-proxied setup, use /api
VITE_API_BASE_URL=/api
